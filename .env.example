NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LLM_API_KEY=
# 멘트 생성(서버 전용). 다 비어 있어도 서비스는 그대로 돌아간다 —
# 멘트가 content/templates.csv 의 예문으로 나갈 뿐이다.
# 여러 개를 넣으면 GEMINI → ANTHROPIC → CLOVA → NVIDIA 순으로 넘어간다(앞이 실패하면 다음이 받는다).
# ⚠ 개인 구독(Gemini Advanced / Claude Pro)과는 별개의 발급이다. API 키가 따로 필요하다.
# Gemini: Google AI Studio(aistudio.google.com) → Get API key
GEMINI_API_KEY=
# Claude: Anthropic Console(console.anthropic.com) → API keys
ANTHROPIC_API_KEY=
# CLOVA Studio(HyperCLOVA X): clovastudio.ncloud.com → API 키. 키 형식은 nv-… 다.
# 한국어 특화라 유료 둘 다음, 비상용(NVIDIA) 앞에 선다. 발급된 키는 테스트 앱 스코프로
# 동작한다(엔드포인트가 /testapp/ 이다). 서비스 앱으로 올리려면 provider.ts 의 스코프 상수를 바꿔라.
CLOVA_API_KEY=
# CLOVA 모델명(선택). 비우면 HCX-DASH-002(실측 4.0초).
# 플래그십 HCX-005 는 5.7초에 크레딧 소모가 크다. HCX-003/006/007/008 은 400 이다.
CLOVA_MODEL=
# NVIDIA NIM: build.nvidia.com → 가입 시 무료 크레딧 약 1천 콜. 키 형식은 nvapi-… 다.
# Gemini 쿼터가 마르는 날의 대비책이다. 넣지 않아도 아무 일도 일어나지 않는다.
NVIDIA_API_KEY=
# NVIDIA 모델명(선택). 비우면 openai/gpt-oss-20b(실측 2초; llama-3.3-70b 는 40초 무응답이라 폐기).
# IfSave 가 쓰는 모델(google/gemma-4-31b-it)과 일부러 다른 것을 쓴다 — 레이트리밋을 나눠 쓰지 않도록.
NVIDIA_MODEL=
# gemini·claude 모델명 덮어쓰기(선택). 비우면 gemini-flash-lite-latest / claude-opus-5.
# CLOVA·NVIDIA 모델은 이 값이 아니라 CLOVA_MODEL / NVIDIA_MODEL 을 본다.
LLM_MODEL=
CLOUDINARY_URL=
NEXT_PUBLIC_KAKAO_JS_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
RESULT_TTL_HOURS=72
DAILY_GEN_LIMIT_PER_UID=20
