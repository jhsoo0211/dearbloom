NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LLM_API_KEY=
# 멘트 생성(서버 전용). 둘 다 비어 있어도 서비스는 그대로 돌아간다 —
# 멘트가 content/templates.csv 의 예문으로 나갈 뿐이다.
# 둘 다 넣으면 GEMINI_API_KEY 를 먼저 쓴다.
# ⚠ 개인 구독(Gemini Advanced / Claude Pro)과는 별개의 발급이다. API 키가 따로 필요하다.
# Gemini: Google AI Studio(aistudio.google.com) → Get API key
GEMINI_API_KEY=
# Claude: Anthropic Console(console.anthropic.com) → API keys
ANTHROPIC_API_KEY=
# 모델명 덮어쓰기(선택). 비우면 gemini-2.0-flash / claude-opus-5.
LLM_MODEL=
CLOUDINARY_URL=
NEXT_PUBLIC_KAKAO_JS_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
RESULT_TTL_HOURS=72
DAILY_GEN_LIMIT_PER_UID=20
