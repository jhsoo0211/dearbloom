NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LLM_API_KEY=
# 멘트 생성(서버 전용). 다 비어 있어도 서비스는 그대로 돌아간다 —
# 멘트가 content/templates.csv 의 예문으로 나갈 뿐이다.
# 여러 개를 넣으면 GEMINI → ANTHROPIC → NVIDIA 순으로 넘어간다(앞이 실패하면 다음이 받는다).
# ⚠ 개인 구독(Gemini Advanced / Claude Pro)과는 별개의 발급이다. API 키가 따로 필요하다.
# Gemini: Google AI Studio(aistudio.google.com) → Get API key
GEMINI_API_KEY=
# Claude: Anthropic Console(console.anthropic.com) → API keys
ANTHROPIC_API_KEY=
# NVIDIA NIM: build.nvidia.com → 가입 시 무료 크레딧 약 1천 콜. 키 형식은 nvapi-… 다.
# Gemini 쿼터가 마르는 날의 대비책이다. 넣지 않아도 아무 일도 일어나지 않는다.
NVIDIA_API_KEY=
# NVIDIA 모델명(선택). 비우면 meta/llama-3.3-70b-instruct.
# IfSave 가 쓰는 모델(google/gemma-4-31b-it)과 일부러 다른 것을 쓴다 — 레이트리밋을 나눠 쓰지 않도록.
NVIDIA_MODEL=
# gemini·claude 모델명 덮어쓰기(선택). 비우면 gemini-flash-lite-latest / claude-opus-5.
# NVIDIA 모델은 이 값이 아니라 NVIDIA_MODEL 을 본다.
LLM_MODEL=
CLOUDINARY_URL=
NEXT_PUBLIC_KAKAO_JS_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
RESULT_TTL_HOURS=72
DAILY_GEN_LIMIT_PER_UID=20
