# Supabase — 콘텐츠 DB. 세 값 모두 Project Settings → API 에서 복사한다.
# 붙이는 순서는 deploy/README.md 의 "Supabase 준비하기" 절: 마이그레이션 0001~0011 실행 →
# 아래 세 값 → `npm run seed -- --apply`(PowerShell 은 `--` 필수). 비어 있으면 앱은
# 지금처럼 content/*.csv 를 읽어 그대로 돌아간다 — 없어도 죽지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
# 공개(anon) 키. NEXT_PUBLIC_ 접두어대로 **브라우저에 나가는 것이 정상**이다 —
# 이 키로 할 수 있는 일의 경계는 RLS 정책(db/migrations/0003·0009)이 정한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키 — RLS 를 통째로 우회한다. **로컬 시드 CLI 전용**이라 호스팅
# 환경변수에는 넣지 않는다(앱 코드는 이 값을 한 줄도 읽지 않는다).
SUPABASE_SERVICE_ROLE_KEY=
# 멘트 생성(서버 전용). 다 비어 있어도 서비스는 그대로 돌아간다 —
# 멘트가 content/templates.csv 의 예문으로 나갈 뿐이다.
# 여러 개를 넣으면 GEMINI → ANTHROPIC → CLOVA → NVIDIA 순으로 넘어간다(앞이 실패하면 다음이 받는다).
# ⚠ 개인 구독(Gemini Advanced / Claude Pro)과는 별개의 발급이다. API 키가 따로 필요하다.
# Gemini: Google AI Studio(aistudio.google.com) → Get API key
GEMINI_API_KEY=
# Claude: Anthropic Console(console.anthropic.com) → API keys
ANTHROPIC_API_KEY=
# CLOVA Studio(HyperCLOVA X): clovastudio.ncloud.com → API 키. 키 형식은 nv-… 다.
# 한국어 특화라 유료 둘 다음, 비상용(NVIDIA) 앞에 선다. 발급된 키는 테스트 앱 스코프로
# 동작한다(엔드포인트가 /testapp/ 이다). 서비스 앱으로 올리려면 provider.ts 의 스코프 상수를 바꿔라.
CLOVA_API_KEY=
# CLOVA 모델명(선택). 비우면 HCX-DASH-002(실측 4.0초).
# 플래그십 HCX-005 는 5.7초에 크레딧 소모가 크다. HCX-003/006/007/008 은 400 이다.
CLOVA_MODEL=
# NVIDIA NIM: build.nvidia.com → 가입 시 무료 크레딧 약 1천 콜. 키 형식은 nvapi-… 다.
# Gemini 쿼터가 마르는 날의 대비책이다. 넣지 않아도 아무 일도 일어나지 않는다.
NVIDIA_API_KEY=
# NVIDIA 모델명(선택). 비우면 openai/gpt-oss-20b(실측 2초; llama-3.3-70b 는 40초 무응답이라 폐기).
# IfSave 가 쓰는 모델(google/gemma-4-31b-it)과 일부러 다른 것을 쓴다 — 레이트리밋을 나눠 쓰지 않도록.
NVIDIA_MODEL=
# gemini·claude 모델명 덮어쓰기(선택). 비우면 gemini-flash-lite-latest / claude-opus-5.
# CLOVA·NVIDIA 모델은 이 값이 아니라 CLOVA_MODEL / NVIDIA_MODEL 을 본다.
LLM_MODEL=
# 11번가 오픈API 키(서버 전용) — 결과 화면 「사러 가기」 시트의 실상품(상품명·가격) 목록.
# ⚠ 2026-08-18 확인: API 신청이 **판매자(셀러) 계정 전용**이라 일반 회원은 발급받지
#   못한다(사용자 실확인). 사업자/셀러 계정이 생기는 날에만 쓸 수 있는 잠자는 길이다.
#   네이버 쇼핑 검색 API 는 2026-08-01 종료(대체 없음), 쿠팡 파트너스는 수수료 링크뿐이라
#   "제휴 아니에요" 고지가 거짓이 된다(원장 §6) — 그래서 현재 실상품 공급원은 없다.
# 비어 있으면 시트는 상품 대신 사이트 목록으로 동작한다 — 없어도 죽지 않는다.
# 키가 생기는 날 `node tests/partners/check-buy-api.mjs` 로 실응답을 한 번 확인하라.
ELEVENST_API_KEY=
# 공공데이터포털(data.go.kr) 공용 인증키 — 마이페이지의 "인코딩된" 키를 그대로 붙인다
# (이미 퍼센트 인코딩돼 있어 다시 인코딩하면 깨진다). 원예특용작물가격동향(15102060)은
# 실측 결과 주간 PDF 게시판이라 구조화 가격이 없다(원장 §6). 경매 시세 폴백을 붙이려면
# 같은 키로 "화훼류농협공판장별경락가격조회"(15109050)를 추가 활용신청한 뒤 말해 달라.
# (실제 .env 는 이 이름을 쓴다 — 수집 스크립트는 옛 이름 DATA_GO_KR_API_KEY 도 함께 받는다)
DATA_GO_API_KEY=
# 배포 도메인(OG·canonical·sitemap의 절대 URL 기준). 비우면 localhost 로 동작한다.
NEXT_PUBLIC_SITE_URL=
# 콘텐츠 CSV 경로를 기본값(<프로젝트>/content)과 다르게 둘 때만 지정한다.
DEARBLOOM_CONTENT_DIR=
